{
  "name": "google-maps-lead-scraper",
  "version": "1.0.0",
  "description": "Scalable Google Maps Lead Scraper using SerpApi, BullMQ, MongoDB",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "scrape": "node src/startScraper.js",
    "worker:maps": "node src/workers/mapsWorker.js",
    "worker:crawl": "node src/workers/crawlWorker.js",
    "workers": "node src/workers/index.js",
    "export": "node src/exportCli.js",
    "dev": "nodemon src/server.js",
    "test:grid": "node scripts/test-grid.js",
    "test:email": "node scripts/test-email-service.js",
    "clear:queue": "node scripts/clear-queue.js",
    "clear:db": "node scripts/clear-database.js"
  },
  "dependencies": {
    "axios": "^1.6.7",
    "bullmq": "^5.1.6",
    "cheerio": "^1.0.0-rc.12",
    "csv-writer": "^1.6.0",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "ioredis": "^5.3.2",
    "mongoose": "^8.1.1",
    "puppeteer": "^22.0.0",
    "validator": "^13.11.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.3"
  }
